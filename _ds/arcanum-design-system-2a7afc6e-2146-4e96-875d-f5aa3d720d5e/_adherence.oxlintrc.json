{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/navigation/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Libertinus Serif Display|Geist|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Libertinus Serif Display, Geist, Geist Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|disabled|href|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, disabled, href, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChapterDots'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|active|onSelect|key|ref|className|style|children)$/]",
        "message": "<ChapterDots> doesn't accept that prop. Declared props: count, active, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodexCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:numeral|title|role|art|width|key|ref|className|style|children)$/]",
        "message": "<CodexCard> doesn't accept that prop. Declared props: numeral, title, role, art, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='Crescent'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|ground|key|ref|className|style|children)$/]",
        "message": "<Crescent> doesn't accept that prop. Declared props: size, color, ground."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:ornament|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: ornament."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute[name.name='ornament'] > Literal[value!=/^(?:star|full|plain)$/]",
        "message": "<Divider> ornament must be one of 'star' | 'full' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Frame'] > JSXAttribute > JSXIdentifier[name!=/^(?:length|color|children|key|ref|className|style|children)$/]",
        "message": "<Frame> doesn't accept that prop. Declared props: length, color, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|wrapperStyle|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, wrapperStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:mark|children|key|ref|className|style|children)$/]",
        "message": "<NavBar> doesn't accept that prop. Declared props: mark, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:numeral|active|children|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: numeral, active, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlateHead'] > JSXAttribute > JSXIdentifier[name!=/^(?:numeral|arcana|rules|title|intro|key|ref|className|style|children)$/]",
        "message": "<PlateHead> doesn't accept that prop. Declared props: numeral, arcana, rules, title, intro."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sparkle'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|key|ref|className|style|children)$/]",
        "message": "<Sparkle> doesn't accept that prop. Declared props: size, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
